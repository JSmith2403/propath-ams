{
  "rewrites": [
    {
      "source": "/athlete",
      "destination": "/athlete.html"
    },
    {
      "source": "/athlete/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/wellness/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/family/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/coach.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/quarterly-nudges",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/weekly-attendance",
      "schedule": "0 11 * * 0"
    }
  ]
}
