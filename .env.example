# ── Client (Vite) ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — set to false to disable the localhost dev auth bypass and test
# real Supabase login during `npm run dev`.
# VITE_DEV_BYPASS=false

# Optional — dev only: seed the dummy roster when the athletes table is empty.
# VITE_SEED_DUMMY=true

# Optional — email of the primary admin (only account that sees athlete delete).
# VITE_MAIN_ADMIN_EMAIL=owner@example.com

# ── Server (Vercel project env vars — NOT read by the client) ────────────────
# Required by /api/* auth guard:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# Required by /api/recipes/extract and /api/ai/draft-report:
# ANTHROPIC_API_KEY=sk-ant-...
# Required by /api/vald/sync:
# VALD_TENANT_ID=...
# VALD_CLIENT_ID=...
# VALD_CLIENT_SECRET=...

# Garmin Connect Developer Program (Starter). Server-side only — never VITE_-prefixed.
# GARMIN_CLIENT_ID=...        # from the app's Credential box on developer.garmin.com
# GARMIN_CLIENT_SECRET=...
# GARMIN_KEY_SECRET=...       # encrypts athletes' Garmin tokens at rest — any long random string; if it is lost everyone must reconnect
# GARMIN_WEBHOOK_KEY=...      # optional: if set, Garmin's push URL must end ?k=<this value> (random hex, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
# GARMIN_REDIRECT_URI=...     # optional override; defaults to https://propath-ams.vercel.app/api/garmin/callback
